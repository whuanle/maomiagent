{
  "name": "@maomiagent/desktop-maomiagent",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "imports": {
    "#maomiagent/ai-application": "../../../packages/ai-application/src/index.ts",
    "#maomiagent/ai-application/*": "../../../packages/ai-application/src/*",
    "#maomiagent/kernel/adapters": "../../../kernel/src/adapters/index.ts",
    "#maomiagent/kernel/adapters/*": "../../../kernel/src/adapters/*",
    "#maomiagent/kernel/host": "../../../kernel/src/host/index.ts",
    "#maomiagent/kernel/host/*": "../../../kernel/src/host/*",
    "#maomiagent/kernel/*": "../../../kernel/*"
  },
  "scripts": {
    "brand:generate": "bun run scripts/generate-brand-assets.ts",
    "start": "bun run scripts/start-dev.ts",
    "dev": "bun run start:hmr",
    "dev:stable": "bun run start",
    "start:hmr": "bun run scripts/start-dev.ts --hmr",
    "dev:hmr": "bun run start:hmr",
    "web:dev": "bun run scripts/start-web-dev.ts",
    "build": "bun run brand:generate && vite build && bun run scripts/build-electrobun-bundle.ts",
    "release:prepare-web": "bun run brand:generate && vite build",
    "release:build": "bun run release:prepare-web && MAOMI_DESKTOP_BUILD_MODE=release bun run scripts/build-electrobun-bundle.ts",
    "release:artifacts:test": "bun test scripts/build-portable-release-assets.test.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@fontsource/ibm-plex-mono": "latest",
    "@fontsource/space-grotesk": "latest",
    "@larksuiteoapi/node-sdk": "^1.64.0",
    "@mdxeditor/editor": "^3.55.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@monaco-editor/loader": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@xiangfa/mindmap": "^0.6.5",
    "antd": "^6.3.1",
    "dompurify": "^3.3.1",
    "electrobun": "latest",
    "ghostty-web": "github:anomalyco/ghostty-web#main",
    "highlight.js": "^11.11.1",
    "html-react-parser": "^6.0.1",
    "katex": "^0.16.44",
    "lucide-react": "latest",
    "marked": "^15.0.12",
    "mermaid": "^11.12.3",
    "monaco-editor": "^0.54.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@resvg/resvg-js": "latest",
    "@types/bun": "latest",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
