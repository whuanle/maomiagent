# Desktop runtime update lookup base URL embedded into the packaged app.
MAOMI_DESKTOP_PUBLIC_SOFTWARE_BASE_URL=https://downloads.example.com/maomiagent/public

# Release identity.
MAOMI_RELEASE_APP_CODE=maomiagent
MAOMI_RELEASE_CHANNEL=stable
MAOMI_DESKTOP_VERSION=0.1.0
MAOMI_RELEASE_VERSION=0.1.0

# Release admin base URL. Upload and release endpoints are derived from this by default.
MAOMI_RELEASE_ADMIN_BASE_URL=https://release-admin.example.com
# Optional overrides for non-standard admin routes.
# MAOMI_RELEASE_UPLOAD_REQUEST_URL=https://release-admin.example.com/admin/software/publish/assets/pre-upload
# MAOMI_RELEASE_UPLOAD_COMPLETE_URL=https://release-admin.example.com/admin/software/publish/assets
# MAOMI_RELEASE_ADMIN_RELEASES_URL=https://release-admin.example.com/admin/software/releases
MAOMI_RELEASE_UPLOAD_AUTH_HEADER=X-WoAI-Publish-Key
MAOMI_RELEASE_UPLOAD_AUTH_TOKEN=replace-with-publish-key

# Release publish is draft-only by default. Set true only when CI should publish automatically.
MAOMI_RELEASE_AUTO_PUBLISH=false

# Release publish auth.
MAOMI_RELEASE_ADMIN_AUTH_HEADER=Authorization
MAOMI_RELEASE_ADMIN_AUTH_TOKEN=replace-with-admin-token

# Optional release metadata.
MAOMI_RELEASE_TITLE=MaomiAgent 0.1.0
MAOMI_RELEASE_IS_FORCE_UPDATE=false
MAOMI_RELEASE_IS_PUSH_ENABLED=false
MAOMI_RELEASE_IS_PRERELEASE=false
# MAOMI_RELEASE_MIN_SUPPORTED_VERSION_CODE=
